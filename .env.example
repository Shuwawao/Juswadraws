# ==========================================
# JUSWADRAWS — ENVIRONMENT CONFIGURATION
# ==========================================
# Safe placeholder values. Rename to .env or .env.local for development.
# In production, set these in Vercel Project Settings > Environment Variables.

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# --- EMAILJS CONFIGURATION ---
# Found in EmailJS Dashboard (Email Services, Email Templates, Account > Public Key)
# Inquiries are configured to deliver to: joshualagare255@gmail.com
VITE_EMAILJS_SERVICE_ID=service_juswadraws
VITE_EMAILJS_TEMPLATE_ID=template_inquiry
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
